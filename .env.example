# ==============================================================================
# WUNKAT HOMES v2 - ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env or .env.local and populate the values for your environment.
# Note: Sensitive production credentials must NEVER be committed to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & GENERAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Official business WhatsApp number for manual transfer receipt submission (e.g. 233XXXXXXXXX without +)
NEXT_PUBLIC_BUSINESS_WHATSAPP="233241234567"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB Atlas / Local)
# ------------------------------------------------------------------------------
# MongoDB connection string with credentials interpolation
DATABASE_URL="mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/wunkat_homes?retryWrites=true&w=majority"
DATABASE_USERNAME="your_mongodb_username"
DATABASE_PASSWORD="your_mongodb_password"
# Optional fallback for local offline database testing
DATABASE_LOCAL="mongodb://localhost:27017/wunkat_homes"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used to sign and verify JSON Web Tokens (session cookies)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# ------------------------------------------------------------------------------
# 4. CLOUDINARY (Media & Document Storage)
# ------------------------------------------------------------------------------
# Cloudinary account credentials for property images and tenant face photos
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="wunkathomes_unsigned"

# ------------------------------------------------------------------------------
# 5. MAPTILER (Geolocation & Interactive Property Maps)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPTILER_PUBLIC_KEY="your_maptiler_public_api_key"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAILS (Resend)
# ------------------------------------------------------------------------------
# API key from resend.com for subscription expiry warnings and admin notifications
RESEND_API_KEY="re_your_resend_api_key"

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & CACHING (Upstash Redis)
# ------------------------------------------------------------------------------
# Serverless Redis instance for zero-latency rate limiting and session guards
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"

# ------------------------------------------------------------------------------
# 8. PAYMENT GATEWAY (Paystack)
# ------------------------------------------------------------------------------
# Paystack test or live keys for card/MoMo payment processing
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
PAYSTACK_SECRET_KEY="sk_test_your_paystack_secret_key"

# ------------------------------------------------------------------------------
# 9. CRON & BACKGROUND AUTOMATION
# ------------------------------------------------------------------------------
# Bearer secret token protecting /api/cron/check-subscriptions endpoint
CRON_SECRET_KEY="generate_a_secure_random_cron_secret_token"

# ------------------------------------------------------------------------------
# 10. TUYA SMART LOCKS (Dual-Account Multi-Cluster Architecture)
# ------------------------------------------------------------------------------
# Tuya IoT Core restricts the free tier to 10 controllable devices per developer account.
# Wunkat Homes utilizes dual-account routing to manage 15+ locks at $0 cloud cost.

# Tuya Account 1 (Primary: Controls Locks 1 - 8)
TUYA_ACCESS_ID_1="your_tuya_account_1_access_id"
TUYA_ACCESS_SECRET_1="your_tuya_account_1_access_secret"
TUYA_ENDPOINT_1="https://openapi.tuyaeu.com"
TUYA_ADMIN_UID_1="your_tuya_account_1_linked_app_uid"
TUYA_LOCK_DEVICE_ID="vdevo178708823868913"

# Tuya Account 2 (Secondary: Controls Locks 9 - 15)
TUYA_ACCESS_ID_2="your_tuya_account_2_access_id"
TUYA_ACCESS_SECRET_2="your_tuya_account_2_access_secret"
TUYA_ENDPOINT_2="https://openapi.tuyaeu.com"
TUYA_ADMIN_UID_2="your_tuya_account_2_linked_app_uid"

# ------------------------------------------------------------------------------
# 11. WEBSOCKETS & REAL-TIME MONITORING (Pusher)
# ------------------------------------------------------------------------------
# Pusher channels configuration for real-time smart lock telemetry and status badges
PUSHER_APP_ID="your_pusher_app_id"
NEXT_PUBLIC_PUSHER_APP_KEY="your_pusher_app_key"
PUSHER_APP_SECRET="your_pusher_app_secret"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

